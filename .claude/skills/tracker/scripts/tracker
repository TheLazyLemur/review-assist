#!/usr/bin/env bash
#
# tracker - the write and query surface of this repo's GitHub Issues.
#
# Methods are <noun>.<verb>. A feature is an issue; a task is one pull request,
# as a sub-issue of its feature. Every write refuses a pull request number, a
# label or status outside the vocabulary, and a feature closed over open tasks.
# Run with TRACKER_DRY_RUN=1 to print the gh commands instead of running them.
#
# Written for bash 3.2 (macOS /bin/bash): no associative arrays or mapfile.

set -euo pipefail

STATUSES="open in-progress blocked done dropped"
RELATIONS="blocked-by relates-to discovered-during"
LABELS="needs-triage ready-for-agent"

usage() {
  cat <<'USAGE'
tracker <method> [args]

  board.list [--status S] [--label L]     features with status and done/total tasks
                                          (dropped tasks not counted); open features
                                          unless --status says otherwise
  issue.get <N>                           issue, comments, tasks, blockers, parent
  task.list <FEATURE>                     a feature's tasks, in order

  issue.create --title T (--body B | --body-file F) [--label L]... [--task T]...
                                          prints the new feature's number, nothing else
  issue.update <N> [--title T] [--body B | --body-file F] [--status S] [--note N]
  issue.delete <N> --yes                  refuses a feature that has tasks
  issue.label.add    <N> <LABEL>
  issue.label.remove <N> <LABEL>
  issue.link.add     <N> <RELATION> <OTHER>
  issue.link.remove  <N> <RELATION> <OTHER>

  task.append <FEATURE> <TITLE> [--body B | --body-file F]
                                          prints the new task's number, nothing else
  task.move   <FEATURE> <TASK> (--before | --after) <OTHER_TASK>

Status:    open | in-progress | blocked | done | dropped
           in-progress assigns you; done and dropped close the issue; dropped
           needs --note saying why; blocked is not set, it comes from a blocker.
Relations: blocked-by | relates-to | discovered-during
           blocked-by is declared from the blocked side: 12 blocked-by 9.
Labels:    needs-triage | ready-for-agent
USAGE
}

die() { printf 'tracker: %s\n' "$*" >&2; exit 1; }

dry() { [ -n "${TRACKER_DRY_RUN:-}" ]; }

in_list() {
  case " $2 " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

assert_number() {
  case "${1-}" in
    ''|*[!0-9]*) die "not an issue number: '${1-}'" ;;
  esac
}

assert_status() {
  in_list "$1" "$STATUSES" || die "status '$1' is outside the vocabulary: $STATUSES"
}

assert_label() {
  in_list "$1" "$LABELS" || die "label '$1' is outside the vocabulary: $LABELS"
}

assert_relation() {
  in_list "$1" "$RELATIONS" || die "relation '$1' is not in use: $RELATIONS"
}

read_body() {
  [ -f "$1" ] || die "no such body file: $1"
  cat -- "$1"
}

# A write through gh. In dry run it prints the command, one shell-quoted word at a
# time, and the body it would send on stdin.
gh_write() {
  local stdin=''
  if [ "${1-}" = --stdin ]; then stdin=$2; shift 2; fi
  if dry; then
    printf 'gh'; printf ' %q' "$@"; printf '\n'
    [ -z "$stdin" ] || printf 'stdin: %s\n' "$stdin"
    return 0
  fi
  if [ -n "$stdin" ]; then printf '%s' "$stdin" | gh "$@"; else gh "$@"; fi
}

# The last path segment of the URL gh issue create prints.
created_number() {
  local url=$1
  url=${url%%[[:space:]]*}
  assert_number "${url##*/}"
  printf '%s' "${url##*/}"
}

# The database id the sub-issue and dependency endpoints take. The issues endpoint
# also answers for pull requests, so refuse those here: every write resolves an id.
issue_id() {
  if dry; then printf 'ID%s' "$1"; return 0; fi
  local id
  id=$(gh api "repos/{owner}/{repo}/issues/$1" --jq 'if .pull_request then "PR" else .id end') \
    || die "no such issue: #$1"
  [ "$id" != PR ] || die "#$1 is a pull request, not an issue"
  printf '%s' "$id"
}

assert_issue() { issue_id "$1" >/dev/null; }

state_of() {
  if dry; then printf 'OPEN'; return 0; fi
  gh issue view "$1" --json state --jq .state
}

open_tasks() {
  if dry; then return 0; fi
  gh api "repos/{owner}/{repo}/issues/$1/sub_issues" --paginate --jq '.[] | select(.state == "open") | "#\(.number)"'
}

task_count() {
  if dry; then printf '0'; return 0; fi
  gh api "repos/{owner}/{repo}/issues/$1/sub_issues" --paginate --jq 'length' | awk '{n += $1} END {print n + 0}'
}

parent_of() {
  if dry; then printf '%s' "${2-}"; return 0; fi
  gh api "repos/{owner}/{repo}/issues/$1/parent" --jq .number 2>/dev/null || true
}

body_of() {
  if dry; then printf 'Body.'; return 0; fi
  gh issue view "$1" --json body --jq .body
}

# The body line a soft link is written as.
link_line() {
  case "$1" in
    relates-to) printf 'Related: #%s' "$2" ;;
    discovered-during) printf 'Discovered during #%s' "$2" ;;
  esac
}

attach_task() {
  gh_write api --method POST "repos/{owner}/{repo}/issues/$1/sub_issues" -F "sub_issue_id=$(issue_id "$2")" --silent
}

create_issue() {
  local title=$1 body=$2; shift 2
  if dry; then
    gh_write --stdin "$body" issue create --title "$title" --body-file - "$@" >&2
    return 0
  fi
  created_number "$(printf '%s' "$body" | gh issue create --title "$title" --body-file - "$@")"
}

# Derived status, for GraphQL issue nodes.
STATUS_JQ='if .state == "CLOSED" then (if .stateReason == "NOT_PLANNED" then "dropped" else "done" end)
  elif ([.blockedBy.nodes[] | select(.state == "OPEN")] | length) > 0 then "blocked"
  elif (.assignees.nodes | length) > 0 then "in-progress"
  else "open" end'

ISSUE_FIELDS='number title state stateReason
  assignees(first: 5) { nodes { login } }
  blockedBy(first: 20) { nodes { number state } }
  labels(first: 10) { nodes { name } }'

graphql() {
  local query=$1; shift
  if dry; then printf 'gh api graphql -f query=%q' "$query"; printf ' %q' "$@"; printf '\n'; return 0; fi
  gh api graphql -f query="$query" "$@"
}

method=${1-}
[ -n "$method" ] || { usage; exit 1; }
shift || true

case "$method" in

  -h|--help|help)
    usage
    ;;

  board.list)
    status='' label=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --status) status=${2-}; assert_status "$status"; shift 2 ;;
        --label) label=${2-}; assert_label "$label"; shift 2 ;;
        *) die "board.list: unknown argument '$1'" ;;
      esac
    done
    states='[OPEN]'
    case "$status" in done|dropped) states='[CLOSED]' ;; esac
    graphql 'query($owner: String!, $repo: String!, $endCursor: String) {
  repository(owner: $owner, name: $repo) {
    issues(first: 100, after: $endCursor, states: '"$states"', orderBy: {field: CREATED_AT, direction: ASC}) {
      pageInfo { hasNextPage endCursor }
      nodes { '"$ISSUE_FIELDS"' parent { number } subIssues(first: 50) { nodes { state stateReason } } }
    }
  }
}' -F owner='{owner}' -F repo='{repo}' --paginate --jq '
  .data.repository.issues.nodes[]
  | select(.parent == null)
  | . + {status: ('"$STATUS_JQ"'), labels: [.labels.nodes[].name],
         done: ([.subIssues.nodes[] | select(.state == "CLOSED" and .stateReason != "NOT_PLANNED")] | length),
         kept: ([.subIssues.nodes[] | select(.stateReason != "NOT_PLANNED")] | length)}
  | select("'"$status"'" == "" or .status == "'"$status"'")
  | select("'"$label"'" == "" or (.labels | index("'"$label"'")))
  | "#\(.number)\t\(.status)\t\(.done)/\(.kept)\t\(.labels | join(","))\t\(.title)"'
    ;;

  issue.get)
    n=${1-}; assert_number "$n"
    if dry; then printf 'gh issue view %s --comments\n' "$n"; else assert_issue "$n"; gh issue view "$n" --comments; fi
    graphql 'query($owner: String!, $repo: String!, $n: Int!) {
  repository(owner: $owner, name: $repo) {
    issue(number: $n) {
      parent { number title }
      blocking(first: 20) { nodes { number state title } }
      subIssues(first: 50) { nodes { '"$ISSUE_FIELDS"' } }
      blockedBy(first: 20) { nodes { number state title } }
    }
  }
}' -F owner='{owner}' -F repo='{repo}' -F n="$n" --jq '
  .data.repository.issue
  | (if .parent then "task of #\(.parent.number) \(.parent.title)" else empty end),
    (.blockedBy.nodes[] | "blocked by #\(.number) (\(.state | ascii_downcase)) \(.title)"),
    (.blocking.nodes[] | "blocks #\(.number) (\(.state | ascii_downcase)) \(.title)"),
    (if (.subIssues.nodes | length) > 0 then "tasks:" else empty end),
    (.subIssues.nodes[] | "  #\(.number)\t\('"$STATUS_JQ"')\t\(.title)")'
    ;;

  task.list)
    n=${1-}; assert_number "$n"
    dry || assert_issue "$n"
    graphql 'query($owner: String!, $repo: String!, $n: Int!) {
  repository(owner: $owner, name: $repo) {
    issue(number: $n) { subIssues(first: 50) { nodes { '"$ISSUE_FIELDS"' } } }
  }
}' -F owner='{owner}' -F repo='{repo}' -F n="$n" --jq '
  .data.repository.issue.subIssues.nodes[] | "#\(.number)\t\('"$STATUS_JQ"')\t\(.title)"'
    ;;

  issue.create)
    title='' body='' have_body=''
    labels=() tasks=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --title) title=${2-}; shift 2 ;;
        --body) body=${2-}; have_body=1; shift 2 ;;
        --body-file) body=$(read_body "${2-}"); have_body=1; shift 2 ;;
        --label) assert_label "${2-}"; labels+=(--label "${2-}"); shift 2 ;;
        --task) [ -n "${2-}" ] || die "issue.create: empty --task"; tasks+=("${2-}"); shift 2 ;;
        *) die "issue.create: unknown argument '$1'" ;;
      esac
    done
    [ -n "$title" ] || die "issue.create: --title is required (a claim, not a topic)"
    [ -n "$have_body" ] || die "issue.create: --body or --body-file is required"
    feature=$(create_issue "$title" "$body" ${labels[@]+"${labels[@]}"})
    dry && feature=999
    next=1000
    for t in ${tasks[@]+"${tasks[@]}"}; do
      task=$(create_issue "$t" "Task of #$feature.")
      dry && { task=$next; next=$((next + 1)); }
      attach_task "$feature" "$task" >&2
    done
    # stdout is the new number and nothing else, so N=$(tracker issue.create ...) works.
    printf '%s\n' "$feature"
    ;;

  task.append)
    feature=${1-}; assert_number "$feature"
    title=${2-}; [ -n "$title" ] || die "task.append: missing title (one mergeable pull request)"
    shift 2 || true
    body="Task of #$feature."
    while [ $# -gt 0 ]; do
      case "$1" in
        --body) body=${2-}; shift 2 ;;
        --body-file) body=$(read_body "${2-}"); shift 2 ;;
        *) die "task.append: unknown argument '$1'" ;;
      esac
    done
    assert_issue "$feature"
    task=$(create_issue "$title" "$body")
    dry && task=1000
    attach_task "$feature" "$task" >&2
    printf '%s\n' "$task"
    ;;

  issue.update)
    n=${1-}; assert_number "$n"; shift || true
    edits=() status='' note='' body='' have_body=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --title) edits+=(--title "${2-}"); shift 2 ;;
        --body) body=${2-}; have_body=1; shift 2 ;;
        --body-file) body=$(read_body "${2-}"); have_body=1; shift 2 ;;
        --status) status=${2-}; assert_status "$status"; shift 2 ;;
        --note) note=${2-}; [ -n "$note" ] || die "issue.update: empty --note"; shift 2 ;;
        *) die "issue.update: unknown argument '$1'" ;;
      esac
    done
    [ ${#edits[@]} -gt 0 ] || [ -n "$have_body" ] || [ -n "$status" ] || [ -n "$note" ] \
      || die "issue.update: nothing to change; name --title, --body, --status or --note"
    case "$status" in
      blocked) die "issue.update: blocked is not set; it comes from an open blocker. Run: tracker issue.link.add $n blocked-by <N>" ;;
      dropped) [ -n "$note" ] || die "issue.update: dropping #$n needs --note saying why" ;;
    esac
    assert_issue "$n"

    if [ -n "$have_body" ]; then
      gh_write --stdin "$body" issue edit "$n" --body-file - "${edits[@]+"${edits[@]}"}"
    elif [ ${#edits[@]} -gt 0 ]; then
      gh_write issue edit "$n" "${edits[@]}"
    fi

    case "$status" in
      done)
        left=$(open_tasks "$n")
        [ -z "$left" ] || die "issue.update: #$n still has open tasks: $(printf '%s' "$left" | tr '\n' ' ')"
        if [ -n "$note" ]; then gh_write issue close "$n" --reason completed --comment "$note"
        else gh_write issue close "$n" --reason completed; fi
        ;;
      dropped)
        gh_write issue close "$n" --reason "not planned" --comment "$note"
        ;;
      open|in-progress)
        [ "$(state_of "$n")" = OPEN ] || gh_write issue reopen "$n"
        if [ "$status" = in-progress ]; then gh_write issue edit "$n" --add-assignee @me
        else gh_write issue edit "$n" --remove-assignee @me; fi
        [ -z "$note" ] || gh_write issue comment "$n" --body "$note"
        ;;
      '')
        [ -z "$note" ] || gh_write issue comment "$n" --body "$note"
        ;;
    esac
    ;;

  issue.delete)
    n=${1-}; assert_number "$n"; shift || true
    yes=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --yes) yes=1; shift ;;
        *) die "issue.delete: unknown argument '$1'" ;;
      esac
    done
    [ -n "$yes" ] || die "issue.delete: pass --yes. Deleting cannot be undone; dropping (--status dropped) keeps the record."
    assert_issue "$n"
    [ "$(task_count "$n")" = 0 ] || die "issue.delete: #$n has tasks; drop or delete them first, or GitHub leaves them without a feature"
    gh_write issue delete "$n" --yes
    ;;

  issue.label.add)
    n=${1-}; assert_number "$n"
    label=${2-}; [ -n "$label" ] || die "issue.label.add: missing label"
    assert_label "$label"
    assert_issue "$n"
    gh_write issue edit "$n" --add-label "$label"
    ;;

  issue.label.remove)
    n=${1-}; assert_number "$n"
    label=${2-}; [ -n "$label" ] || die "issue.label.remove: missing label"
    assert_issue "$n"
    gh_write issue edit "$n" --remove-label "$label"
    ;;

  issue.link.add|issue.link.remove)
    n=${1-}; assert_number "$n"
    relation=${2-}; [ -n "$relation" ] || die "$method: missing relation"
    assert_relation "$relation"
    other=${3-}; assert_number "$other"
    [ "$n" != "$other" ] || die "$method: #$n cannot link to itself"
    other_id=$(issue_id "$other")
    assert_issue "$n"
    if [ "$relation" = blocked-by ]; then
      if [ "$method" = issue.link.add ]; then
        gh_write api --method POST "repos/{owner}/{repo}/issues/$n/dependencies/blocked_by" -F "issue_id=$other_id" --silent
      else
        gh_write api --method DELETE "repos/{owner}/{repo}/issues/$n/dependencies/blocked_by/$other_id" --silent
      fi
    else
      line=$(link_line "$relation" "$other")
      body=$(body_of "$n")
      if [ "$method" = issue.link.add ]; then
        case $'\n'"$body"$'\n' in *$'\n'"$line"$'\n'*) die "$method: #$n already says '$line'" ;; esac
        gh_write --stdin "$body"$'\n\n'"$line" issue edit "$n" --body-file -
      else
        case $'\n'"$body"$'\n' in *$'\n'"$line"$'\n'*) ;; *) die "$method: #$n does not say '$line'" ;; esac
        kept=$(printf '%s\n' "$body" | grep -vxF -- "$line" || true)
        gh_write --stdin "$kept" issue edit "$n" --body-file -
      fi
    fi
    ;;

  task.move)
    feature=${1-}; assert_number "$feature"
    task=${2-}; assert_number "$task"
    where=${3-}
    case "$where" in
      --before) field=before_id ;;
      --after) field=after_id ;;
      *) die "task.move: name --before or --after, then the other task" ;;
    esac
    other=${4-}; assert_number "$other"
    [ "$task" != "$other" ] || die "task.move: #$task cannot move relative to itself"
    for t in "$task" "$other"; do
      [ "$(parent_of "$t" "$feature")" = "$feature" ] || die "task.move: #$t is not a task of #$feature"
    done
    gh_write api --method PATCH "repos/{owner}/{repo}/issues/$feature/sub_issues/priority" \
      -F "sub_issue_id=$(issue_id "$task")" -F "$field=$(issue_id "$other")" --silent
    ;;

  *)
    printf 'tracker: no such method: %s\n\n' "$method" >&2
    usage >&2
    exit 1
    ;;
esac
